#!/usr/bin/env bash
set -euo pipefail

SOURCE=/usr/share/hypratomic/defaults
TARGET="${XDG_CONFIG_HOME:-$HOME/.config}/hypratomic"

usage() {
    cat <<'USAGE'
Usage: hypratomic-bootstrap [--force]

Copies Hypratomic's versioned starter configuration into:
  ~/.config/hypratomic/

This command deliberately does NOT modify ~/.config/hypr, ~/.config/waybar,
or ~/.config/quickshell. Phase 1 keeps Wayblue's working desktop intact.

Options:
  --force   Replace an existing ~/.config/hypratomic after backing it up.
USAGE
}

force=0
case "${1:-}" in
    "") ;;
    --force) force=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

if [[ -e "$TARGET" ]]; then
    if (( force == 0 )); then
        printf 'Refusing to overwrite %s\n' "$TARGET" >&2
        printf 'Use --force to back it up and replace it.\n' >&2
        exit 1
    fi
    stamp="$(date +%Y%m%d-%H%M%S)"
    backup="${TARGET}.backup-${stamp}"
    mv "$TARGET" "$backup"
    printf 'Backed up existing configuration to %s\n' "$backup"
fi

mkdir -p "$TARGET"
cp -a "$SOURCE"/. "$TARGET"/

cat <<EOF2
Installed Phase 1 starter files in:
  $TARGET

Nothing in your active Hyprland/Waybar/Quickshell configuration was changed.
Run:
  hypratomic-doctor
before beginning Phase 2.
EOF2
