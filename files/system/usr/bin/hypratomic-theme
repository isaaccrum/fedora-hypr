#!/usr/bin/env bash
set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
theme_root=/usr/share/hypratomic/theme

install_if_missing() {
    local target="$1"
    local template="$2"
    [[ -r "$template" ]] || {
        printf 'Missing image theme template: %s\n' "$template" >&2
        return 1
    }
    if [[ -e "$target" || -L "$target" ]]; then
        printf 'Preserving existing configuration: %s\n' "$target"
        return 0
    fi
    mkdir -p "$(dirname "$target")"
    install -m 600 "$template" "$target"
    printf 'Installed Hypratomic theme fragment: %s\n' "$target"
}

install_if_missing "$config_home/foot/foot.ini" "$theme_root/foot.ini"
install_if_missing "$config_home/gtk-3.0/settings.ini" "$theme_root/gtk-3.0/settings.ini"
install_if_missing "$config_home/gtk-4.0/settings.ini" "$theme_root/gtk-4.0/settings.ini"
